{
    "name": "osus-electron",
    "version": "1.0.0",
    "description": "OSUS Desktop App",
    "author": "No-Spacing",
    "type": "commonjs",
    "main": "src/js/main.js",
    "scripts": {
        "vite:dev": "vite",
        "electron:run": "electron .",
        "dev": "concurrently -k \"npm run vite:dev\" \"wait-on http://localhost:5173 && npm run electron:run\"",
        "build": "vite build",
        "package": "npm run build && electron-builder"
    },
    "build": {
        "appId": "com.example.myapp",
        "productName": "MyApp",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "src/js/main.js"
        ],
        "win": {
            "target": [
                "nsis"
            ]
        },
        "mac": {
            "target": [
                "dmg"
            ]
        },
        "linux": {
            "target": [
                "AppImage"
            ]
        }
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.8",
        "concurrently": "^10.0.5",
        "electron": "^44.0.0",
        "electron-builder": "^26.15.3",
        "vite": "^8.2.2",
        "wait-on": "^9.1.0"
    },
    "dependencies": {
        "@primeuix/themes": "^3.0.0",
        "@primevue/forms": "^5.0.1",
        "@tailwindcss/vite": "^4.3.3",
        "primeicons": "^8.0.0",
        "primevue": "^4.5.5",
        "tailwindcss": "^4.3.3",
        "vue": "^3.5.42",
        "vue-router": "^5.3.0"
    }
}
